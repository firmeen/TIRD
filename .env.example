# Copy this file to .env and fill the values from your OWN authorized
# Chrome TIRD session. Never commit .env or publish live credentials.
#
# Textual UI (default): the current Browser session is polled every 1 second.
# You control Chrome; the app never opens or changes browser pages.
# One shared Cookie + Authorization works for both sections in the Nov 18 trace.
TIRD_AUTHORIZATION=
TIRD_COOKIE=

# Required by the existing curl client as a normal Content page Referer.
# For the LIVE UI, this value does NOT select the section:
# TIRD chooses based on the latest page of the shared browser session.
TIRD_REFERER=https://tirdmember.tird.insure/Content?_mId=YOUR_CURRENT_MENU_ID

# The following per-section Referers are OPTIONAL and retained only for the
# older separate-Referer headless CLI/diagnostic workflow from PR #3.
# They are NOT used by the live 1-second Textual UI.
# TIRD_ADVISOR_REFERER=
# TIRD_INSIGHTS_REFERER=
# TIRD_ADVISOR_COOKIE=
# TIRD_INSIGHTS_COOKIE=
# TIRD_ADVISOR_AUTHORIZATION=
# TIRD_INSIGHTS_AUTHORIZATION=
