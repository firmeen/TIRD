# Copy to .env. Paste values ONLY from your own logged-in TIRD browser session.
# DO NOT COMMIT .env / real authorization tokens or cookies.

# Legacy/default session (used as Advisor fallback for existing users)
TIRD_AUTHORIZATION=
TIRD_COOKIE=
TIRD_REFERER=https://tirdmember.tird.insure/Content?_mId=YOUR_ADVISOR_ID

# Advisor can override any legacy values.
# TIRD_ADVISOR_AUTHORIZATION=
# TIRD_ADVISOR_COOKIE=
# TIRD_ADVISOR_REFERER=https://tirdmember.tird.insure/Content?_mId=YOUR_ADVISOR_ID

# REQUIRED to include Business Insights. Copy its Referer from its
# own GetService network request. Optional Cookie/Auth overrides are
# supported if your active authorized session differs from Advisor.
TIRD_INSIGHTS_REFERER=
# TIRD_INSIGHTS_AUTHORIZATION=
# TIRD_INSIGHTS_COOKIE=
